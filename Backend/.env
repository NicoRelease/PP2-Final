# Configuración del servidor
PORT=3000
NODE_ENV=development # Cambiar a 'production' en despliegue

# --- Seguridad ---
JWT_SECRET="clave-secreta-256bits"
BCRYPT_SALT_ROUNDS=10


# --- Configuración de SQLite ---
DB_FILE="../data/dev_database.sqlite"

# 🔑 NUEVA OPCIÓN: Controla si Sequelize debe crear/alterar las tablas
# Útil: 'true' para desarrollo/pruebas. 'false' para producción.
DB_SYNC_ENABLED=true

# --- Supabase / PostgreSQL ---
# Los datos de conexión los obtienes en la configuración de base de datos de Supabase.

#DB_HOST="db.PP2.supabase.co"
#DB_USER="postgres"
#DB_PASSWORD="tu_contraseña_de_postgres"
#DB_NAME="nombre_de_la_db"
#DB_PORT=5432a